# passwords.example — Mosquitto password file
#
# The real file is mqtt/config/passwords and is git-ignored: it contains bcrypt
# hashes. Generate it on the host, never by hand and never in this repository.
#
#   docker run --rm -it -v "$PWD/config:/mosquitto/config" eclipse-mosquitto:2 \
#     mosquitto_passwd -c /mosquitto/config/passwords frigate
#   # then WITHOUT -c for each additional account:
#   docker run --rm -it -v "$PWD/config:/mosquitto/config" eclipse-mosquitto:2 \
#     mosquitto_passwd /mosquitto/config/passwords homeassistant
#   docker run --rm -it -v "$PWD/config:/mosquitto/config" eclipse-mosquitto:2 \
#     mosquitto_passwd /mosquitto/config/passwords probe
#
#   chmod 0600 config/passwords
#
# The three accounts match config/acl:
#   frigate         read/write on the camera topic tree
#   homeassistant   read/write on the camera + Home Assistant topic trees
#   probe           read-only, used by probe.py to verify the broker
#
# The resulting file looks like this — one account per line, bcrypt hash after
# the colon. These are NOT real hashes.
#
# frigate:$7$101$EXAMPLE_HASH_DO_NOT_USE$EXAMPLE
# homeassistant:$7$101$EXAMPLE_HASH_DO_NOT_USE$EXAMPLE
# probe:$7$101$EXAMPLE_HASH_DO_NOT_USE$EXAMPLE
