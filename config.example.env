# config.example.env — copy to config.env and fill in.
#
#   cp config.example.env config.env
#   chmod 600 config.env
#   $EDITOR config.env
#
# config.env is git-ignored. Environment variables override it. Point
# HOMELAB_CONFIG at another file to use that instead (exclusive when set).
#
# Addresses below come from the RFC documentation ranges and point at nothing:
#   192.0.2.0/24    RFC 5737 (TEST-NET-1)
#   100.64.0.0/10   RFC 6598 (CGNAT; the range Tailscale also uses)
#
# No value here has a real fallback in the source. A missing required key
# raises ConfigError instead of guessing.

# ═════════════════════════════════════════════
# Nodes
# ═════════════════════════════════════════════

# Primary node — runs Home Assistant, the primary AdGuard, MQTT.
PRIMARY_NODE_IP=192.0.2.20
PRIMARY_NODE_TAILSCALE_IP=100.64.0.10

# Secondary node — runs the secondary AdGuard and acts as backup target.
SECONDARY_NODE_IP=192.0.2.22
SECONDARY_NODE_TAILSCALE_IP=100.64.0.11

# LAN gateway. AdGuard uses it as last-resort upstream and as the target for
# reverse (PTR) lookups, because the router owns the DHCP leases.
ROUTER_IP=192.0.2.1

# The home LAN, in CIDR form. Goes into AdGuard's client allowlist.
LAN_SUBNET=192.0.2.0/24

# ═════════════════════════════════════════════
# AdGuard Home
# ═════════════════════════════════════════════

# Admin credential files, one per node. JSON, see dns/examples/credentials.example.json
# Keep them outside this repository.
PRIMARY_ADGUARD_CREDENTIALS=/etc/metehantech-dns/credentials.json
SECONDARY_ADGUARD_CREDENTIALS=/etc/metehantech-dns/secondary-credentials.json

# ═════════════════════════════════════════════
# Persistent AdGuard clients
# Tailscale addresses are stable per device, so they are safe to pin.
# Phone/tablet LAN addresses come from DHCP and are deliberately NOT pinned.
# ═════════════════════════════════════════════

PRIMARY_PHONE_NAME=Primary phone (Android)
PRIMARY_PHONE_TAILSCALE_IP=100.64.0.20
CLIENT_PHONE_NAME=Secondary phone (Android)
CLIENT_PHONE_TAILSCALE_IP=100.64.0.21

# IP camera, pinned by LAN address.
CAMERA_IP=192.0.2.110

# ═════════════════════════════════════════════
# Containers and paths
# ═════════════════════════════════════════════

HA_CONTAINER=homeassistant
MQTT_CONTAINER=mosquitto

# Home Assistant project directory on the primary node (holds compose.yaml and config/).
HA_PROJECT_DIR=/srv/homeassistant

# Where cluster tools write backups and result files.
CLUSTER_BACKUP_ROOT=/var/backups/metehantech-homelab
