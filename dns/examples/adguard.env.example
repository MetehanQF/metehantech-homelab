# .env.example — metehantech-dns ortam degerleri
#
# Gercek dosya: bu dizindeki .env  (0600, .gitignore'da)
# Hem compose.yaml (Docker Compose otomatik okur) hem configure.py bunu kullanir.
#
# Buradaki adresler RFC dokumantasyon bloklarindandir, gercek cihaza isaret etmez:
#   192.0.2.0/24    RFC 5737 (TEST-NET-1)
#   100.64.0.0/10   RFC 6598 (CGNAT; Tailscale de bu araligi kullanir)
#
# Kurulum:  cp .env.example .env && chmod 600 .env && nano .env
#
# Fallback YOKTUR: bir deger eksikse compose "required variable ... is missing"
# hatasi verir, configure.py ise NetworkConfigError firlatir. Bu bilinclidir —
# bu serviste sessiz bir varsayilan, 0.0.0.0'a bind ederek acik resolver demektir.

# ═════════════════════════════════════════════
# Host adresleri
# ═════════════════════════════════════════════

PRIMARY_NODE_IP=192.0.2.20
PRIMARY_NODE_TAILSCALE_IP=100.64.0.10
SECONDARY_NODE_IP=192.0.2.22
SECONDARY_NODE_TAILSCALE_IP=100.64.0.11
CAMERA_IP=192.0.2.110

# Router / varsayilan ag gecidi. AdGuard icin hem son care upstream
# hem de LAN PTR sorgularinin gittigi yer (DHCP kiralarinin sahibi).
ROUTER_IP=192.0.2.1

# Ev LAN'i. AdGuard allowlist'ine girer (acik resolver savunmasi).
LAN_SUBNET=192.0.2.0/24

# ═════════════════════════════════════════════
# Container kullanicisi (secondary-node compose)
# AdGuard'in veri dizini bu uid/gid tarafindan yazilabilir olmali. Host'ta
# bind-mount edilen conf/ ve work/ dizinlerinin sahibini kullanin:  id -u ; id -g
# ═════════════════════════════════════════════

AGH_UID=1000
AGH_GID=1000

# ═════════════════════════════════════════════
# AdGuard kalici istemci tanimlari
# Tailscale adresleri cihaz basina kalici atanir, bu yuzden pinlenebilir.
# Telefon/tablet LAN adresleri DHCP'den gelir ve BILEREK pinlenmez.
# ═════════════════════════════════════════════

PRIMARY_PHONE_NAME=Primary phone (Android)
PRIMARY_PHONE_TAILSCALE_IP=100.64.0.20
CLIENT_PHONE_NAME=Secondary phone (Android)
CLIENT_PHONE_TAILSCALE_IP=100.64.0.21
